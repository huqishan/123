<UserControl x:Class="Module.Business.Features.Scheme.Views.SchemeConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:searchBox="clr-namespace:ControlLibrary.Controls.SearchBox.Control;assembly=ControlLibrary"
             xmlns:schemeViews="clr-namespace:Module.Business.Features.Scheme.Views"
             mc:Ignorable="d"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             d:DesignHeight="760"
             d:DesignWidth="1800">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource 方案配置}" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="{DynamicResource 维护方案、工步顺序与步骤内容。}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <searchBox:SearchBox Grid.Row="1"
                                     Margin="0,16,0,0"
                                     PlaceholderText="{DynamicResource 搜索方案配置...}"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <UniformGrid Grid.Row="2" Columns="6" Margin="0,16,0,16">
                    <Button Content="{DynamicResource 新建}"
                            Command="{Binding NewSchemeCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="{DynamicResource 复制}"
                            Command="{Binding DuplicateSchemeCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="{DynamicResource 删除}"
                            Command="{Binding DeleteSchemeCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="{DynamicResource 保存}"
                            Click="SaveSchemesButton_Click"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="{DynamicResource 导入}"
                            Command="{Binding ImportSchemeCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="{DynamicResource 导出}"
                            Command="{Binding ExportSchemeCommand}"
                            Style="{StaticResource ActionButtonStyle}" />
                </UniformGrid>

                <ListBox x:Name="SchemesListBox"
                         Grid.Row="3"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                         ItemsSource="{Binding SchemesView}"
                         SelectedItem="{Binding SelectedScheme, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBox FontSize="15"
FontWeight="SemiBold"
Style="{StaticResource SchemeNameTextBoxStyle}"
Text="{Binding SchemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,0"
                                  Foreground="{DynamicResource AppMutedTextBrush}"
                                  Text="{Binding LastModifiedText}"
                                  TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="35" Margin="10,0,0,0"
                                        Command="{Binding DataContext.OpenConditionEditorCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        ToolTip="编辑方案中显示到界面的判断条件">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 漏斗图标用于表达对方案判断条件的集中筛选与维护。 -->
                                        <Path Width="14"
                                              Height="14"
                                              Margin="0,0,6,0"
                                              Data="M1,2 H15 L10,8 V13 L6,15 V8 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                              Stretch="Uniform" />
                                        <TextBlock VerticalAlignment="Center" Text="判断条件" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Border HorizontalAlignment="Right"
Margin="0,0,0,5"
Padding="12,6"
VerticalAlignment="Top"
Background="{DynamicResource TabCardBackgroundBrush}"
BorderBrush="{DynamicResource TabItemBorderBrush}"
BorderThickness="1"
CornerRadius="999">
                        <TextBlock FontWeight="SemiBold"
       Foreground="{Binding PageStatusBrush}"
       Text="{Binding PageStatusText}" />
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="18"
Background="{DynamicResource TabItemBackgroundBrush}"
BorderBrush="{DynamicResource TabItemBorderBrush}"
BorderThickness="1"
CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource 方案工步}" />
                                        </StackPanel>

                                        <StackPanel DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                                            <Button Content="{DynamicResource 添加工步}"
                Command="{Binding AddWorkStepToSchemeCommand}"
                Style="{StaticResource PrimaryActionButtonStyle}" />
                                            <Button Margin="12,0,0,0"
                Content="{DynamicResource 删除}"
                Command="{Binding RemoveWorkStepFromSchemeCommand}"
                Style="{StaticResource ActionButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Grid.Row="1"
           Margin="0,8,0,10"
           Foreground="{DynamicResource AppMutedTextBrush}"
           Text="{DynamicResource 直接在方案中维护工步，拖拽可调整顺序。}"
           TextWrapping="Wrap" />

                                    <Grid Grid.Row="2">
                                        <DataGrid x:Name="SchemeStepsDataGrid"
              HorizontalScrollBarVisibility="Disabled"
              ItemsSource="{Binding SelectedScheme.Steps}"
              SelectedItem="{Binding SelectedSchemeStep, Mode=TwoWay}"
              IsReadOnly="False"
              AllowDrop="True"
              PreviewMouseLeftButtonDown="SchemeStepsDataGrid_PreviewMouseLeftButtonDown"
              PreviewMouseMove="SchemeStepsDataGrid_PreviewMouseMove"
              PreviewMouseRightButtonDown="SchemeStepsDataGrid_PreviewMouseRightButtonDown"
              MouseDoubleClick="SchemeStepsDataGrid_MouseDoubleClick"
              CellEditEnding="SchemeStepsDataGrid_CellEditEnding"
              DragOver="SchemeStepsDataGrid_DragOver"
              DragLeave="SchemeStepsDataGrid_DragLeave"
              Drop="SchemeStepsDataGrid_Drop"
              Style="{StaticResource ColumnsDataGridStyle}">
                                            <DataGrid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Style="{StaticResource StructureContextMenuStyle}">
                                                    <MenuItem Header="{DynamicResource 添加工步}"
                          Command="{Binding AddWorkStepToSchemeCommand}"
                          Style="{StaticResource StructureContextMenuItemStyle}">
                                                        <MenuItem.Icon>
                                                            <Viewbox Width="32" Height="32">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Style="{StaticResource ContextMenuIconPathStyle}"
                                      Data="M4,8 L12,8 M8,4 L8,12" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{DynamicResource 删除工步}"
                          Command="{Binding RemoveWorkStepFromSchemeCommand}"
                          Style="{StaticResource StructureContextMenuItemStyle}">
                                                        <MenuItem.Icon>
                                                            <Viewbox Width="32" Height="32">
                                                                <Canvas Width="16" Height="16">
                                                                    <Path Style="{StaticResource ContextMenuIconPathStyle}"
                                      Data="M5,5 L11,5 M7,5 L7,4 L9,4 L9,5 M6,7 L6.4,13 L9.6,13 L10,7 M7.5,8 L7.5,12 M8.5,8 L8.5,12" />
                                                                </Canvas>
                                                            </Viewbox>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="{DynamicResource 选择}">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding DataContext.AreAllSchemeStepsChecked, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.HeaderTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                   IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Width="64"
Header="{DynamicResource 序号}" SortMemberPath="Num"
Binding="{Binding Num, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
ElementStyle="{StaticResource CellTextBlockStyle}"
EditingElementStyle="{StaticResource CellTextBoxStyle}" />
                                                <DataGridTextColumn Width="1.45*"
                                Header="{DynamicResource 工步名称}" IsReadOnly="True"
                                Binding="{Binding StepName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ElementStyle="{StaticResource CellTextBlockStyle}"
                                EditingElementStyle="{StaticResource CellTextBoxStyle}" />
                                                <DataGridTemplateColumn Width="76">
                                                    <DataGridTemplateColumn.HeaderTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center"
VerticalAlignment="Center"
Content="{DynamicResource 启用}"
IsChecked="{Binding DataContext.AreAllSchemeStepsStartupEnabled, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.HeaderTemplate>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox HorizontalAlignment="Center"
VerticalAlignment="Center"
IsChecked="{Binding IsStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                            
                                        </DataGrid>

                                        <Canvas x:Name="SchemeStepDropIndicatorCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False">
                                            <Border x:Name="SchemeStepDropIndicator"
                Height="3"
                CornerRadius="2"
                Visibility="Collapsed"
                Background="{DynamicResource PrimaryButtonBrush}" />
                                        </Canvas>
                                        <!-- 工步参数从页面下方向上滑入，编辑值直接绑定当前方案工步。 -->
                                        <Grid x:Name="WorkStepParameterDrawerHost"
              Grid.ColumnSpan="3"
              Panel.ZIndex="32"
              Opacity="0"
              IsHitTestVisible="False">
                                            <Border Background="#3A000000"
                    MouseLeftButtonDown="WorkStepParameterDrawerBackdrop_MouseLeftButtonDown" />
                                            <Border x:Name="WorkStepParameterDrawerSheet"
                    Height="360"
                    Padding="24"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource DrawerBorderStyle}">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="WorkStepParameterDrawerTranslateTransform" Y="56" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource 工步参数}" />
                                                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource AppMutedTextBrush}" Text="配置工步执行参数，保存后才会写入方案。" />
                                                        </StackPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button
                                                                    Content="{DynamicResource 关闭}"
                                                                    Command="{Binding CloseWorkStepParameterDrawerCommand}"
                                                                    Style="{StaticResource ActionButtonStyle}" />
                                                            <Button Margin="12,0,0,0" Content="{DynamicResource 保存}"
        Command="{Binding SaveWorkStepParameterDrawerCommand}"
        Style="{StaticResource PrimaryActionButtonStyle}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Grid Grid.Row="1" Margin="0,16,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock VerticalAlignment="Center" Text="执行 ID：" />
                                                            <TextBox Width="80" MinHeight="38"
Style="{StaticResource InputTextBoxStyle}"
Text="{Binding EditingSchemeWorkStep.Num, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <CheckBox Margin="16,0,0,0"
VerticalAlignment="Center"
Content="启用工步"
IsChecked="{Binding EditingSchemeWorkStep.IsStartupEnabled, Mode=TwoWay}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                                                            <TextBlock VerticalAlignment="Center" Text="工步名称" />
                                                            <TextBox Margin="0,8,0,0" MinHeight="38"
Style="{StaticResource InputTextBoxStyle}"
Text="{Binding EditingSchemeWorkStep.StepName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,16,0,0">
                                                            <TextBlock VerticalAlignment="Center" Text="内置工步" />
                                                            
                                                            <ComboBox Margin="0,8,0,0"
                                                                      MinHeight="38" Style="{StaticResource InputComboBoxStyle}"
                                               ItemContainerStyle="{StaticResource InputComboBoxItemStyle}"
          SelectionChanged="WorkStepTypeComboBox_SelectionChanged"
          ItemsSource="{Binding WorkStepTypes}"
          SelectedItem="{Binding EditingSchemeWorkStep.StepType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                                            <TextBlock VerticalAlignment="Center" Text="重测次数：" />
                                                            <TextBox Margin="0,8,0,0" MinHeight="38"
Style="{StaticResource InputTextBoxStyle}"
IsEnabled="{Binding EditingSchemeWorkStep.IsReTestEnabled}"
Text="{Binding EditingSchemeWorkStep.ReTestCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="3" Margin="0,16,0,0">
                                                            <CheckBox Content="启用 NG 重测"
IsChecked="{Binding EditingSchemeWorkStep.IsReTestEnabled, Mode=TwoWay}" />
                                                            <CheckBox Margin="0,10,0,0"
Content="重测是否弹窗"
IsEnabled="{Binding EditingSchemeWorkStep.IsReTestEnabled}"
IsChecked="{Binding EditingSchemeWorkStep.IsConfirmReTest, Mode=TwoWay}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Column="2" Margin="16,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,30,0,0" Grid.Row="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
 Text="{DynamicResource 输入参数}" />
                                        <DataGrid x:Name="InvokeParameterDataGrid" Grid.Row="1"
AutoGenerateColumns="False"
HorizontalScrollBarVisibility="Disabled"
IsReadOnly="False"
ItemsSource="{Binding EditingParameterRows}"
SelectedValuePath="Parameter"
SelectedValue="{Binding SelectedEditingInvokeParameter, Mode=TwoWay}"
Style="{StaticResource ColumnsDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="0.5*"
                      Header="工步值名称">
                                                   
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="*"
                      Header="{DynamicResource 参数值}">
                                                    
                                                </DataGridTemplateColumn>
                                                
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabelStyle}"
 Text="{DynamicResource 返回参数}" />
                                        <DataGrid Grid.Row="1"
AutoGenerateColumns="False"
HorizontalScrollBarVisibility="Disabled"
IsReadOnly="False"
ItemsSource="{Binding EditingParameterRows}"
SelectedValuePath="Parameter"
SelectedValue="{Binding SelectedEditingInvokeParameter, Mode=TwoWay}"
Style="{StaticResource ColumnsDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="0.5*" Header="工步值名称">
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="*" Header="{DynamicResource 判断条件}">
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                                
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                
            </Border>

            
        </Grid>


        <schemeViews:SchemeConditionEditorDrawerView Grid.ColumnSpan="3"
                                                       Panel.ZIndex="31"
                                                       Editor="{Binding ConditionEditor}" />



    </Grid>
</UserControl>
