<UserControl x:Class="Module.Business.Features.Scheme.Views.SchemeConditionEditorDrawerView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="DrawerHost"
          Opacity="0"
          IsHitTestVisible="False">
        <Border Background="#3A000000"
                MouseLeftButtonDown="DrawerBackdrop_MouseLeftButtonDown" />

        <Border x:Name="DrawerSheet"
                Width="980"
                HorizontalAlignment="Right"
                Style="{StaticResource DrawerBorderStyle}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslateTransform" X="56" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="关闭"
                                Command="{Binding Editor.CloseCommand, ElementName=Root}"
                                Style="{StaticResource ActionButtonStyle}" />
                        <Button Content="保存条件"
                                Command="{Binding Editor.SaveCommand, ElementName=Root}"
                                Style="{StaticResource PrimaryActionButtonStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{Binding Editor.Title, ElementName=Root}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Text="集中维护方案中需要显示到界面的返回值；默认优先展示已勾选项。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Margin="0,16,0,12"
                        Padding="12,8"
                        Background="{DynamicResource TabItemBackgroundBrush}"
                        BorderBrush="{DynamicResource TabItemBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DockPanel LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left"
                                  VerticalAlignment="Center"
                                  Content="显示全部返回值"
                                  IsChecked="{Binding Editor.ShowAllReturns, ElementName=Root, Mode=TwoWay}" />
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedTextBrush}">
                            <Run Text="已选 " />
                            <Run FontWeight="SemiBold" Text="{Binding Editor.SelectedConditionCount, ElementName=Root, Mode=OneWay}" />
                            <Run Text=" / 共 " />
                            <Run Text="{Binding Editor.TotalConditionCount, ElementName=Root, Mode=OneWay}" />
                            <Run Text=" 项" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HorizontalScrollBarVisibility="Auto"
                          IsReadOnly="False"
                          ItemsSource="{Binding Editor.ConditionsView, ElementName=Root}"
                          Style="{StaticResource ColumnsDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Width="64"
                                                Header="显示"
                                                Binding="{Binding IsShowView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTemplateColumn Width="1.2*" Header="界面显示名称">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource CellTextBoxStyle}"
                                             Text="{Binding ViewDataName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ViewDataName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="1.05*"
                                            Header="来源工步"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextBlockStyle}"
                                            Binding="{Binding WorkStepName, Mode=OneWay}" />
                        <DataGridTextColumn Width="1.35*"
                                            Header="步骤"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextBlockStyle}"
                                            Binding="{Binding OperationSummary, Mode=OneWay}" />
                        <DataGridTextColumn Width="1.1*"
                                            Header="返回值集合"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextBlockStyle}"
                                            Binding="{Binding ReturnValueCollectionName, Mode=OneWay}" />
                        <DataGridTextColumn Width="1.1*"
                                            Header="返回值键"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextBlockStyle}"
                                            Binding="{Binding ReturnValueKey, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="未显示的返回值可通过“显示全部返回值”展开后勾选。关闭抽屉不会保存本次修改。"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
